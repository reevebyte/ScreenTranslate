{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Local ScreenTranslate windows; network, credentials, and event broadcast stay behind Rust commands.",
  "windows": ["main", "quick", "result", "result-tools", "selection-*"],
  "permissions": [
    "core:app:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-hide",
    "core:window:allow-set-focus"
  ]
}
